    "council": {
      "type": "object",
      "required": [
        "rounds",
        "final_decision",
        "summary"
      ],
      "properties": {
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "round": {
                "type": "integer"
              },
              "verdicts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "member",
                    "verdict",
                    "reason",
                    "quote",
                    "weakest_line",
                    "scores"
                  ],
                  "properties": {
                    "member": {
                      "enum": [
                        "Strategy Director",
                        "Creative Director",
                        "Voice Guardian",
                        "Performance Analyst",
                        "Trust Officer"
                      ]
                    },
                    "verdict": {
                      "enum": [
                        "approve",
                        "revise",
                        "reject"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    },
                    "changes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "quote": {
                      "type": "string",
                      "description": "Exact text from the script this verdict is about"
                    },
                    "weakest_line": {
                      "type": "string",
                      "description": "Weakest line in the script, quoted, even when approving"
                    },
                    "scores": {
                      "type": "object",
                      "description": "1-5 per rubric criterion of this member"
                    },
                    "basis": {
                      "$ref": "#/$defs/basis"
                    }
                  }
                }
              },
              "decision": {
                "enum": [
                  "ship",
                  "revise",
                  "ship_with_issues",
                  "blocked_claim"
                ]
              }
            }
          },
          "maxItems": 3
        },
        "final_decision": {
          "enum": [
            "ship",
            "ship_with_issues",
            "blocked_claim"
          ]
        },
        "open_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "single_context",
            "subagents"
          ]
        }
      }
    },
